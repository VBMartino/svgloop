{
  "name": "svgloop",
  "version": "0.1.0",
  "description": "MCP server that draws logos and icons as clean SVG with your own local models: plan, draft, render, review with a vision model, revise, export.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "svg", "logo", "icon", "llama.cpp", "ollama", "local-llm", "vision"],
  "homepage": "https://github.com/VBMartino/svgloop#readme",
  "repository": { "type": "git", "url": "git+https://github.com/VBMartino/svgloop.git" },
  "bugs": { "url": "https://github.com/VBMartino/svgloop/issues" },
  "bin": { "svgloop": "dist/cli.js" },
  "main": "dist/index.js",
  "exports": { ".": "./dist/index.js" },
  "files": [
    "dist/cli.js",
    "dist/index.js",
    "examples/*.svg",
    "style.md",
    "svgloop.config.example.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": { "node": ">=20.3" },
  "scripts": {
    "cli": "bun src/cli.ts",
    "mcp": "bun src/cli.ts mcp",
    "test": "bun test",
    "typecheck": "bun check",
    "build": "bun run build:node && bun run build:exe",
    "build:node": "bun build src/cli.ts --target node --packages external --banner \"#!/usr/bin/env node\" --outfile dist/cli.js && bun build index.ts --target node --packages external --outfile dist/index.js",
    "build:exe": "bun build src/cli.ts --compile --outfile dist/svgloop",
    "notices": "bun scripts/third-party-notices.ts",
    "prepublishOnly": "bun test && bun run build:node"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-js": "^2.6.2",
    "@xmldom/xmldom": "^0.9.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "peerDependenciesMeta": {
    "typescript": { "optional": true }
  }
}
